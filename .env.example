# Optional private RPC endpoints. Without these the app falls back to public RPCs
# (fine for browsing; a private endpoint is recommended for production reliability).
NEXT_PUBLIC_SEPOLIA_RPC_URL=
NEXT_PUBLIC_MAINNET_RPC_URL=

# Optional: enable WalletConnect (mobile + non-injected wallets) by setting a
# free project id from https://cloud.walletconnect.com. Injected wallets
# (MetaMask/Rabby) work without this.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# Your public GitHub repo (shown in the footer).
NEXT_PUBLIC_GITHUB_URL=

# Your deployed URL — makes social/link-preview (OG) images resolve absolutely.
# On Vercel this is auto-detected; set it explicitly for a custom domain.
NEXT_PUBLIC_SITE_URL=

# --- Mainnet relayer access (Sepolia needs none of this) ---
# Server-only API key for Zama's hosted mainnet relayer. Apply at
# https://docs.zama.org/protocol/sdk/alpha/guides/relayer-api-keys
# The key never reaches the browser: /api/relayer proxies and injects it.
ZAMA_RELAYER_API_KEY=
# UI flag: set to "true" once the key above is deployed, to enable
# mainnet reveal/wrap/unwrap in the interface.
NEXT_PUBLIC_MAINNET_RELAYER_ENABLED=
